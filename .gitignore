# ─── 含敏感数据，绝不能上传 ───
unitree_robots_config.json   # 含 AES-128 密钥、邮箱、机器人 IP
*.aes
*.key
logs/                         # 含真实机器人 IP / SN
choreo_auto/*.json            # 本地自动录制的编排（可能含场地信息）
!choreo_auto/.gitkeep

# ─── Python 字节码 / 缓存 ───
__pycache__/
*.py[cod]
*$py.class
*.so

# ─── PyInstaller 打包产物 ───
build/
dist/
*.manifest
*.spec.bak

# ─── 上传时不需要的备份 / 旧版本 ───
unitree_webrtc_connect-master-old/
*.zip
*.bak
*.tmp

# ─── 虚拟环境 ───
.venv/
venv/
env/
.python-version

# ─── IDE / 系统文件 ───
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ─── Claude Code 本地工作目录 ───
.claude/

BUG_FIX_SUMMARY.md

CLAUDE.md
FEATURES.md